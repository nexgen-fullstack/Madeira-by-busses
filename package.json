{
  "name": "madeirabus",
  "private": true,
  "description": "Journey planner for the whole Madeira bus network (SIGA): routes with transfers, fares, timetables and GPS get-off alerts.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @madeirabus/web dev",
    "build": "pnpm data && pnpm --filter @madeirabus/web build",
    "preview": "pnpm --filter @madeirabus/web preview",
    "data": "pnpm --filter @madeirabus/pipeline run demo",
    "data:real": "pnpm --filter @madeirabus/pipeline run real",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
