{
  "name": "@madeirabus/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Madeira by busses for Android (and iOS): the web app in a Capacitor shell with background GPS get-off alerts.",
  "type": "module",
  "scripts": {
    "web": "pnpm --filter @madeirabus/web exec vite build --mode app",
    "sync": "cap sync android",
    "build": "pnpm web && pnpm sync",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
