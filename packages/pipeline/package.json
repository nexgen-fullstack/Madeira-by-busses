{
  "name": "@madeirabus/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Nightly data pipeline: fetch GTFS feeds, validate, merge and build the compact network bundle for the app.",
  "type": "module",
  "bin": {
    "madeirabus-pipeline": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts demo --out ../../data/demo/gtfs && tsx src/cli.ts build --demo --feed demo=../../data/demo/gtfs --out ../../apps/web/public/data/demo.json --report ../../data/build/demo-report.md",
    "real": "tsx src/cli.ts build --strict --pretty-names --extend-days 120 --missing 'CAM,SIGA Rodoeste' --places ../../data/sources/osm/places.json --feed 'hf=https://www.horariosdofunchal.pt/googletransit.zip|https://storage.googleapis.com/storage/v1/b/mdb-latest/o/pt-regiao-autonoma-da-madeira-horarios-do-funchal-transportes-publicos-gtfs-3104.zip?alt=media' --out ../../apps/web/public/data/network.json --report ../../data/build/report.md --diff ../../data/build/diff.md",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@madeirabus/engine": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
